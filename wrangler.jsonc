{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameplatform",
  "main": "worker/index.ts",
  // >= 2026-04-07 才會自動回 WebSocket Close frame（worker/room.ts 依賴這個行為）
  "compatibility_date": "2026-10-01",
  // 2026-11-17 起 game.tryit.wtf 給 v2（GamePlatform-v2）用，這版暫時不綁網域、不開 workers.dev 網址（收不到流量、不花錢）。
  // 要再上線：在這裡加一個新的網域，例如 [{ "pattern": "party.tryit.wtf", "custom_domain": true }]。
  // 不要填回 game.tryit.wtf，部署時會把網域從 v2 搶回來。
  "routes": [],
  "workers_dev": false,
  "preview_urls": false,
  // 網頁是 next build 輸出的靜態檔，免費、不叫醒 Worker；只有 /ws（沒有對應檔案）會進 Worker
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      // 一個房間一個實例，只負責牽線
      { "name": "ROOMS", "class_name": "SignalRoom" },
      // 全站每日連線上限，只有一個實例
      { "name": "BUDGET", "class_name": "DailyBudget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom", "DailyBudget"] }],
  // 限流編號整個 Cloudflare 帳號共用；VideoSaas 用 83xx，這個專案用 84xx
  "ratelimits": [
    // 牽線連線：每個 IP 每 60 秒 10 條（數字也寫在 lib/signal.ts 的 LIMITS，改的時候兩邊一起改）
    { "name": "RL_CONNECT", "namespace_id": "8401", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // 全站每天最多幾條牽線連線進得了房間（保險絲），UTC 0 點重置
    "DAILY_CONNECTION_LIMIT": "2000"
  }
}
